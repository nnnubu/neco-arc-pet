# 依赖目录（可重建/体积大，不入库）
node_modules/
voice-env/
voice-env310/

# 语音模型与运行时资产（大文件，物理保留但不入库）
voice/models/
voice/assets/
voice/bin/

# 运行时输出
voice/output/
voice/tmp/
voice/cache/

# 日志与系统文件
*.log
Thumbs.db
Desktop.ini

# Python 缓存
__pycache__/
*.pyc

# 根目录临时测试产物（_开头，禁止入库）
/_*.wav
/_*.mp3
/_*.py
/_*.txt

# PET_DEBUG 调试截图
debug-*.png

# API Key 等本地敏感配置
.env

# AI 问答缓存
voice/ai_cache.json

# 翻唱产物（大体积 wav，物理保留不入库）
voice/sing_output/
