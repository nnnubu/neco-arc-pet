# 依赖目录（可重建/体积大，不入库）
node_modules/
voice-env/
voice-env310/

# 语音模型与运行时资产（大文件，物理保留但不入库）
voice/models/
voice/assets/
voice/bin/

# 运行时输出
voice/output/
voice/tmp/
voice/cache/

# 日志与系统文件
*.log
Thumbs.db
Desktop.ini

# Python 缓存
__pycache__/
*.pyc

# 根目录临时测试产物（_开头，禁止入库）
/_*.wav
/_*.mp3
/_*.py
/_*.txt

# PET_DEBUG 调试截图
debug-*.png

# API Key 等本地敏感配置
.env

# AI 设置面板配置（含密钥，本地保留不入库）
assets/ai-config.json

# AI 问答缓存
voice/ai_cache.json

# AI 问答缓存迁移（基础包无 voice 目录，缓存放 assets；运行时派生不入库）
assets/ai_cache.json
assets/kb_embeddings.json

# TTS 面板配置（本地保留不入库）
assets/tts-config.json

# 翻唱产物（大体积 wav，物理保留不入库）
voice/sing_output/
_调试文件/

# electron-builder 构建产物（可重新构建，不入库）
dist/

# 语音合成输出（本地保留不入库）
voice/tts_output/


# 用户本地偏好（随机动作/界面语言等），不入库；他人克隆后按需新建
assets/user-config.json
