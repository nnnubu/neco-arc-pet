{
  "name": "neco-arc-pet",
  "version": "1.0.0",
  "description": "Neco Arc 猫姬桌宠（便携基础包，语音扩展包可选）",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.necoarc.pet",
    "productName": "NecoArc Pet",
    "directories": {
      "output": "dist",
      "buildResources": "assets/icons"
    },
    "files": [
      "main/**",
      "renderer/**",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "arc-knowledge/**",
          "icons/**",
          "sprite/**",
          "vendor/**",
          "voice-clips/**"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/arc.ico",
      "artifactName": "NecoArc-Pet-${version}.${ext}"
    }
  }
}
